OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=30000
# Supabase project configuration. Keep real values in .env only.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the server to use the live Supabase database. Use the Session
# pooler URI from Project Settings > Database and percent-encode its password.
DATABASE_URL=
DATABASE_POOL_SIZE=8
PUBLIC_URL=http://127.0.0.1:4173

# Optional real email delivery. Without these, messages remain in the outbox.
RESEND_API_KEY=
MAIL_FROM=Tiger Ops <notifications@example.edu>

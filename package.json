{
  "name": "tiger-ops-campus-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiger Ops: Grambling-modeled campus operations with Supabase-ready schema, row-level security, invitations, and student sign-up.",
  "scripts": {
    "dev": "node server/index.mjs",
    "db:seed-sql": "node scripts/generate-seed.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.16",
    "supabase": "2.120.0"
  }
}
